# ============================================================
# Application
# ============================================================
NODE_ENV=development
PORT=3000
APP_NAME=school-erp-backend
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ============================================================
# PostgreSQL (Primary DB — Drizzle ORM)
# ============================================================
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_pg_password
PG_DATABASE=school_erp
PG_SSL=false
PG_POOL_MIN=2
PG_POOL_MAX=20
DATABASE_URL=postgresql://postgres:your_pg_password@localhost:5432/school_erp

# ============================================================
# MongoDB (Documents / Logs / Audit Trails)
# ============================================================
MONGO_URI=mongodb://localhost:27017/school_erp_logs
MONGO_DB_NAME=school_erp_logs

# ============================================================
# Redis
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=erp:

# ============================================================
# JWT
# ============================================================
JWT_ACCESS_SECRET=your_access_token_secret_min_32_chars_here
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# AWS S3 (File Uploads)
# ============================================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=school-erp-files
AWS_S3_BASE_URL=https://school-erp-files.s3.ap-south-1.amazonaws.com

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ============================================================
# File Upload
# ============================================================
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ============================================================
# Swagger
# ============================================================
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE=School ERP API
SWAGGER_VERSION=1.0.0
